# Copie para ~/.config/muninn/semanal.env (chmod 600). Sem aspas: o systemd lê o valor literal.
# As credenciais do SigPesq continuam em Muninn/etl/.env (ou no Infisical), como no ETL manual.

# Pasta PRIVADA onde ficam manifest.json e dados-<versão>.db.gz (nunca o GitHub Pages: a base tem nomes).
MUNINN_PUBLICAR_DESTINO=/srv/muninn/dados

# Opcional: envia para um servidor depois de publicar.
#MUNINN_PUBLICAR_RSYNC=muninn@servidor:/srv/muninn/dados/

# Opcional: etapas a pular nesta máquina (a carga usa os brutos que já existem).
#MUNINN_SEMANAL_PULAR=lattes
