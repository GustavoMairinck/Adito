{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Adito",
  "version": "0.1.0",
  "identifier": "br.edu.ifes.leds.adito",
  "build": {
    "frontendDist": "../frontend-vue/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Adito · IFES Campus Serra",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCRDdGNkYyNkI2M0FDNzMKUldSenJHTnI4dmJYYTdPQXlrR29GT3kvVFI2SzFYZVhnN3kvbUg3TnNnMUtEVFNDZXVIYUpZTlEK",
      "endpoints": [
        "https://github.com/SmartIdea-ifes-serra/Adito/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
